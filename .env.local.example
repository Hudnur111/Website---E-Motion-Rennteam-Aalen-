# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored and never committed - see README.md "Content-Pflege
# mit dem eigenen CMS" for the full setup walkthrough (or just run
# CMS-Zugangsdaten-aendern.bat/.command for a guided, interactive setup).

# Login username for the CMS admin panel (/admin/login).
CMS_ADMIN_USER=admin

# Password hash for CMS_ADMIN_USER, generated with:
#   npm run cms:hash-password -- "mein-passwort"
CMS_ADMIN_PASSWORD_HASH=

# Random, secret string (16+ chars) used to sign session cookies, e.g.:
#   openssl rand -hex 32
CMS_SESSION_SECRET=

# Optional GitHub integration: when set, every CMS save is committed
# directly to this repository via the GitHub Contents API. Without it,
# changes are only written to the local filesystem.
# Fine-grained personal access token with "Contents: Read and write" on
# this repository: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=Hudnur111
GITHUB_REPO=Website---E-Motion-Rennteam-Aalen-
GITHUB_BRANCH=main

# Optionale Online-Benutzerverwaltung: wenn gesetzt, werden neue CMS-Zugänge,
# Passwort-Hashes und Rollen ("Admin", "Sponsoring-Management") verschlüsselt
# im privaten Repo E-Motion-Rennteam-Aalen-e-V/Login-Benutzerverwaltung
# gespeichert statt nur lokal in .cms-users.json. Ohne diese Variablen
# funktioniert das CMS wie bisher (nur CMS_ADMIN_USER + lokale Zusatz-Nutzer).
# BEWUSST GETRENNT von GITHUB_TOKEN/GITHUB_OWNER/GITHUB_REPO oben (die für die
# Inhalts-Commits der Website verwendet werden) - siehe SECURITY.md im
# credentials-repo für die Begründung der Token-Trennung.
#
# Fine-grained Personal Access Token, NUR für dieses eine private Repo,
# Permission "Contents: Read and write": https://github.com/settings/tokens
CMS_CREDENTIALS_TOKEN=
CMS_CREDENTIALS_OWNER=E-Motion-Rennteam-Aalen-e-V
CMS_CREDENTIALS_REPO=Login-Benutzerverwaltung
# Wird per `npm run add-admin -- --username ... --password ... --roles ...`
# im credentials-repo automatisch erzeugt und dort in .env gespeichert -
# NICHT von Hand setzen, NIEMALS committen. Siehe README des credentials-repo.
CMS_CREDENTIALS_ENCRYPTION_KEY=
CMS_CREDENTIALS_KEY_ID=v1

# Required in production: destination for form submissions (contact,
# sponsoring, mitmachen, mediakit, newsletter), e.g. a Slack/Teams incoming
# webhook URL or a small internal relay that sends email. Without this,
# submissions are only buffered locally in .pending-form-submissions.jsonl
# instead of being delivered live - see README.md "Betrieb &
# Sicherheitshinweise".
FORM_WEBHOOK_URL=
